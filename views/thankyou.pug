extends ./ui_layout

block content
  .thirteen.wide.column.center.aligned
    h2(style="text-align:center; font-weight: normal;") Thank you for engaging on
      img(src=cdn+'/favicon.svg', height="50px", style="margin-bottom:-10px")
      span.title VidShare
      | !
    h2(style="text-align:center; text-decoration: underline;") Please now return to the Qualtrics Survey to answer some questions.
    button.ui.primary.button.blue.big.logoutLink(href=qualtricsUrl, style="margin: 20px;") Go to Qualtrics Survey
      
block styles 
    link(type='text/css', rel='stylesheet', href='/public/css/signup.css')